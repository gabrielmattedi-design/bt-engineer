# Banco. OBRIGATÓRIO em produção — sem ele a aplicação LANÇA ao servir a primeira análise.
# Em desenvolvimento, a ausência faz cair para armazenamento em arquivo (perde no restart).
# Vercel + Neon/Supabase: use a connection string do POOLER, não a direta.
DATABASE_URL=postgresql://user:pass@localhost:5432/tennis_engineer

# Dataset: 'strict' bloqueia variantes não verificadas (forçado em produção)
DATASET_MODE=permissive

# IA — OPCIONAL. Sem chave, o sistema usa o gerador determinístico de explicações.
ANTHROPIC_API_KEY=

# Pagamentos: fake (dev/E2E) | mercadopago | stripe (adapters ainda não implementados)
# O adapter "fake" LANÇA em produção — ele concede acesso sem cobrar.
PAYMENT_PROVIDER=fake
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Sessão
SESSION_COOKIE_SECRET=troque-por-uma-string-aleatoria-de-32-bytes

# Painel de curadoria (/admin). Mínimo 8 caracteres.
# Sem esta variável o painel fica INDISPONÍVEL — nunca há senha padrão.
ADMIN_PASSWORD=
